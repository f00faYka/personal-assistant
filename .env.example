API_HOST=127.0.0.1
API_PORT=3000
API_DATABASE_PATH=local-data/api.sqlite
API_BLOB_ROOT=local-data/blobs
# dev:all gets model selection from ai-runtime-manager; the API uses that model for requests and provenance.
WHISPER_ENDPOINT=http://127.0.0.1:8080/inference
WHISPER_HEALTH_ENDPOINT=http://127.0.0.1:8080/health
WHISPER_MODEL=ggml-small
WHISPER_TIMEOUT_MS=120000
TRANSCRIPTION_MAX_ATTEMPTS=3
OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/chat
OLLAMA_HEALTH_ENDPOINT=http://127.0.0.1:11434/api/tags
OLLAMA_TIMEOUT_MS=120000
INTERPRETATION_MAX_ATTEMPTS=3
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
SUPERVISOR_READINESS_TIMEOUT_MS=120000
SUPERVISOR_POLL_INTERVAL_MS=250
