{
  "name": "personal-assistant",
  "private": true,
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/api",
    "apps/mobile"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "fsevents": false
  },
  "scripts": {
    "prepare": "husky",
    "validate": "npm run lint && npm run typecheck && npm run mobile:typecheck && npm test && npm run mobile:test",
    "lint": "npm run lint --workspace @personal-assistant/api && npm run lint --workspace @personal-assistant/mobile",
    "build": "npm run build --workspace @personal-assistant/api",
    "start": "npm run start --workspace @personal-assistant/api",
    "dev": "npm run dev --workspace @personal-assistant/api",
    "typecheck": "npm run typecheck --workspace @personal-assistant/api",
    "test": "npm run test --workspace @personal-assistant/api",
    "test:health": "npm run test:health --workspace @personal-assistant/api",
    "test:migrations": "npm run test:migrations --workspace @personal-assistant/api",
    "test:blobs": "npm run test:blobs --workspace @personal-assistant/api",
    "test:watch": "npm run test:watch --workspace @personal-assistant/api",
    "mobile:typecheck": "npm run typecheck --workspace @personal-assistant/mobile",
    "mobile:test": "npm run test --workspace @personal-assistant/mobile",
    "mobile:start": "npm run start --workspace @personal-assistant/mobile",
    "mobile:fixture": "EXPO_PUBLIC_UI_FIXTURE=true npm run start --workspace @personal-assistant/mobile",
    "mobile:web": "npm run web --workspace @personal-assistant/mobile",
    "mobile:web:fixture": "EXPO_PUBLIC_UI_FIXTURE=true npm run web --workspace @personal-assistant/mobile",
    "mobile:materials-prototype": "EXPO_PUBLIC_UI_FIXTURE=true EXPO_PUBLIC_MATERIALS_PROTOTYPE=true npm run start --workspace @personal-assistant/mobile",
    "mobile:web:materials-prototype": "EXPO_PUBLIC_UI_FIXTURE=true EXPO_PUBLIC_MATERIALS_PROTOTYPE=true npm run web --workspace @personal-assistant/mobile",
    "dev:all": "node scripts/start-dev.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "typescript-eslint": "^8.71.2"
  }
}
